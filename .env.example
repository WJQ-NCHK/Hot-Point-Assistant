# ============================================================
# 热点追踪助手 · 环境变量样例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会提交。
#
# 云端运行时（GitHub Actions）不需要此文件 ——
# 同名变量在仓库 Settings → Secrets and variables → Actions 中配置。
# ============================================================

# ---- 邮件发送（必填，本地完整运行时）----
# SMTP 服务器。QQ 邮箱为 smtp.qq.com:465(SSL)；其他邮箱按官方文档改
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true

# 发件邮箱地址（即你的 QQ 邮箱）
SMTP_USER=

# SMTP 授权码（不是登录密码！）
# QQ 邮箱获取路径：网页版邮箱 → 设置 → 账号 → 开启 SMTP 服务 → 生成授权码
SMTP_AUTH_CODE=

# 收件人（可填同一个邮箱，自己发给自己）
MAIL_TO=

# ---- LLM（必填）----
# DeepSeek API Key，https://platform.deepseek.com 申请
# 兼容任何 OpenAI 协议服务：改 LLM_BASE_URL / LLM_MODEL 即可
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120

# ---- 检索（可选，有默认值）----
DOMAIN_NAME=三维重建与新视图合成
# 留空则使用内置检索式（3D reconstruction / NVS / 3DGS / NeRF / SfM / image-to-3D 等）
ARXIV_QUERY=
LOOKBACK_DAYS=30
MAX_RESULTS=60
MIN_PICKS=5
MAX_PICKS=10

# ---- 运行（可选）----
STATE_PATH=.workbuddy/papers_seen.json
REPORT_DIR=reports
DRY_RUN=false
FORCE=false
